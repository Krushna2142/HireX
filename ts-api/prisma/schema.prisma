// -----------------------------
// Recruiter Interview Feedback
// -----------------------------

model RecruiterInterviewFeedback {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interviewId          String   @map("interview_id") @db.Uuid
  roundId              String   @unique @map("round_id") @db.Uuid
  recruiterId          String   @map("recruiter_id") @db.Uuid
  technicalScore       Decimal  @map("technical_score") @db.Decimal(4, 2)
  communicationScore   Decimal  @map("communication_score") @db.Decimal(4, 2)
  problemSolvingScore  Decimal  @map("problem_solving_score") @db.Decimal(4, 2)
  cultureFitScore      Decimal  @default(3) @map("culture_fit_score") @db.Decimal(4, 2)
  overallScore         Decimal  @map("overall_score") @db.Decimal(5, 2)
  recommendation       String
  strengths            String?
  improvements         String?
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  round                RecruiterInterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  recruiter            User      @relation("FeedbackRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt], map: "idx_rif_interview_created")
  @@index([recruiterId], map: "idx_rif_recruiter")
  @@map("recruiter_interview_feedback")
}

